{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sgsolutions",
  "workers_dev": true,
  // Match the audited production settings. Never persist request metadata for
  // statistics. Query redaction also protects URLs if logging is enabled later.
  "observability": {
    "redact_query_string": true,
    "logs": {"enabled": false, "invocation_logs": false},
    "traces": {"enabled": false}
  },
  "main": "worker.mjs",
  "triggers": {"crons": ["*/15 * * * *"]},
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {"directory": ".open-next/assets", "binding": "ASSETS"},
  "routes": [
    {"pattern": "sgsolutionscr.com/*", "zone_name": "sgsolutionscr.com"},
    {"pattern": "www.sgsolutionscr.com/*", "zone_name": "sgsolutionscr.com"}
  ],
  "services": [{"binding": "WORKER_SELF_REFERENCE", "service": "sgsolutions"}],
  "vars": {"SG_ENTORNO": "produccion", "PEDIDOS_ORIGEN_PUBLICO": "https://sgsolutionscr.com"},
  "env": {
    "preview": {
      "name": "sg-preview",
      "services": [{"binding": "WORKER_SELF_REFERENCE", "service": "sg-preview"}],
      "vars": {"SG_ENTORNO": "test"}
    }
  }
}
