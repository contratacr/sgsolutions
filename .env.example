# Copiar a .env.local. Únicamente Supabase LOCAL para desarrollo.
SG_ENTORNO=local
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
CUENTAS_SUPABASE_URL=
CUENTAS_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Configurar solo cuando se vaya a probar correo de negocio.
BREVO_API_KEY=
BREVO_REMITENTE=

# Pedidos y administración: credenciales privadas del servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ID público de Meta Pixel de SG Solutions. Puede sustituirse por entorno.
# Tilopay: credenciales privadas para pruebas locales. Nunca usar NEXT_PUBLIC_.
TILOPAY_PRODUCCION_VERIFICADA_EN=
TILOPAY_ENTORNO_RESPUESTA=
TILOPAY_MODO=
TILOPAY_PRUEBA_VERIFICADA_EN=
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
TILOPAY_API_KEY=
TILOPAY_RETORNO_URL=
# Pedidos SINPE/transferencia: activar tras aplicar la migración y configurar correo.
PEDIDOS_MANUALES_ACTIVOS=
PEDIDOS_ENLACE_SECRET=
PEDIDOS_ORIGEN_PUBLICO=
NEXT_PUBLIC_META_PIXEL_ID=

# Eurocomp: secretos SOLO del servidor. API Key o credenciales legacy.
EUROCOMP_API_KEY=
EUROCOMP_WEB_SERVICE_ID=
EUROCOMP_PASSWORD=
# 0 funcionó en la prueba; confirmar su significado con Eurocomp.
EUROCOMP_BODEGA_ID=0
# Activar únicamente en un servidor con capacidad para procesar el catálogo completo.
EUROCOMP_ACTUALIZACION_ACTIVA=

# GitHub Actions, desactivado hasta configurar secretos y migraciones.
EUROCOMP_SYNC_ACTIVA=

# Publicidad: nunca reutilizar dataset/tokens de otro negocio. Mantener apagado hasta validación.
SG_META_ACTIVO=0
META_DATASET_ID=1837501974261618
META_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
# Códigos UTM de campañas autorizados, separados por coma; sin datos de personas.
SG_CAMPANAS_PERMITIDAS=
# Secreto independiente de 32+ caracteres para la tarea privada de reintentos.
SG_MEDICION_PROCESADOR_SECRET=
